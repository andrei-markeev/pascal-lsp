    <Call ERROR="Expected 3 parameters, but got 2"><SymbRef>Copy</SymbRef><RW>(</RW><SymbRef>s</SymbRef><RW>,</RW> <Num>1</Num><RW>)</RW></Call><RW>;</RW>
    <Call><SymbRef>Copy</SymbRef><RW>(</RW><SymbRef>s</SymbRef><RW>,</RW> <Str ERROR="Invalid parameter: expected integer or assignment-compatible, but found string!">'hello'</Str><RW>,</RW> <Num>3</Num><RW>)</RW></Call><RW>;</RW>
<RW>end</RW></Block><RW>.</RW></ProgramFile>
