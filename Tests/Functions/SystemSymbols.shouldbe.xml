    <VarDecl><SymbDecl>u</SymbDecl><RW>:</RW> <TypeSpec><Ident>PtrUInt</Ident></TypeSpec></VarDecl><RW>;</RW>
    <VarDecl><SymbDecl>i</SymbDecl><RW>:</RW> <TypeSpec><Ident>PtrInt</Ident></TypeSpec></VarDecl><RW>;</RW>
    <VarDecl><SymbDecl>qw</SymbDecl><RW>:</RW> <TypeSpec><Ident>QWord</Ident></TypeSpec></VarDecl><RW>;</RW></VarSection>
<Block><RW>begin</RW>
