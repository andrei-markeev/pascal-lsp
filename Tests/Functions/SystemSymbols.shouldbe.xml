<ProgramFile><RW>program</RW> <SymbDecl>SystemSymbols</SymbDecl><RW>;</RW>

{$mode objfpc}
{$longstrings on}

<TUsesClause><RW>uses</RW> <Ident>sysutils</Ident><RW>,</RW> <Ident>strings</Ident><RW>;</RW></TUsesClause>

<VarSection><RW>var</RW>
