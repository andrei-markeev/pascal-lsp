    <Call><SymbRef>FillChar</SymbRef><RW>(</RW><SymbRef>buf</SymbRef><RW>,</RW> <Call><SymbRef>SizeOf</SymbRef><RW>(</RW><SymbRef>buf</SymbRef><RW>)</RW></Call><RW>,</RW> <Num>0</Num><RW>)</RW></Call><RW>;</RW>
    <Assignment><SymbRef>qw</SymbRef> <RW>:=</RW> <Num>12345</Num></Assignment><RW>;</RW>
    <Assignment><SymbRef>u</SymbRef> <RW>:=</RW> <VarRef><Ident>PtrUInt</Ident><RW>(</RW><SymbRef>p</SymbRef><RW>)</RW></VarRef></Assignment><RW>;</RW>
    <Assignment><SymbRef>i</SymbRef> <RW>:=</RW> <VarRef><Ident>PtrInt</Ident><RW>(</RW><SymbRef>qw</SymbRef><RW>)</RW></VarRef></Assignment><RW>;</RW>
    <Assignment><SymbRef>u</SymbRef> <RW>:=</RW> <VarRef><Ident>PtrUInt</Ident><RW>(</RW><SymbRef>u</SymbRef><RW>)</RW></VarRef></Assignment><RW>;</RW>
<RW>end</RW></Block><RW>.</RW></ProgramFile>
