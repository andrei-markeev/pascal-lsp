<ProgramFile><RW>program</RW> <SymbDecl>PathFunctions</SymbDecl><RW>;</RW>

{$mode objfpc}
{$longstrings on}

<TUsesClause><RW>uses</RW> <Ident>sysutils</Ident><RW>;</RW></TUsesClause>

<VarSection><RW>var</RW>
    <VarDecl><SymbDecl>p</SymbDecl><RW>,</RW> <SymbDecl>s</SymbDecl><RW>,</RW> <SymbDecl>ext</SymbDecl><RW>,</RW> <SymbDecl>fp</SymbDecl><RW>,</RW> <SymbDecl>exp</SymbDecl><RW>:</RW> <TypeSpec><RW>string</RW></TypeSpec></VarDecl><RW>;</RW></VarSection>
<Block><RW>begin</RW>
    <Assignment><SymbRef>s</SymbRef> <RW>:=</RW> <Str>'C:\path\to\file.txt'</Str></Assignment><RW>;</RW>
    <Assignment><SymbRef>p</SymbRef> <RW>:=</RW> <Call><SymbRef>ExcludeTrailingPathDelimiter</SymbRef><RW>(</RW><Str>'C:\path\to\'</Str><RW>)</RW></Call></Assignment><RW>;</RW>
    <Assignment><SymbRef>p</SymbRef> <RW>:=</RW> <Call><SymbRef>IncludeTrailingPathDelimiter</SymbRef><RW>(</RW><Str>'C:\path\to'</Str><RW>)</RW></Call></Assignment><RW>;</RW>
    <Assignment><SymbRef>ext</SymbRef> <RW>:=</RW> <Call><SymbRef>ExtractFileExt</SymbRef><RW>(</RW><SymbRef>s</SymbRef><RW>)</RW></Call></Assignment><RW>;</RW>
    <Assignment><SymbRef>fp</SymbRef> <RW>:=</RW> <Call><SymbRef>ExtractFilePath</SymbRef><RW>(</RW><SymbRef>s</SymbRef><RW>)</RW></Call></Assignment><RW>;</RW>
    <Assignment><SymbRef>exp</SymbRef> <RW>:=</RW> <Call><SymbRef>ExpandFileName</SymbRef><RW>(</RW><Str>'relative/path.txt'</Str><RW>)</RW></Call></Assignment><RW>;</RW>
<RW>end</RW></Block><RW>.</RW></ProgramFile>
